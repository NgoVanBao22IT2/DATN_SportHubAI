# ==========================================
# ArenaReserve Git Ignore Config (Monorepo/Root)
# ==========================================

# Thư mục thư viện dependencies
node_modules/
**/node_modules/

# Các file cấu hình bảo mật / biến môi trường nhạy cảm
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env.local

# Thư mục build và output biên dịch
dist/
**/dist/
build/
**/build/
out/
**/out/
web-build/
**/web-build/

# Expo / React Native specific
.expo/
**/.expo/
*.jks
*.p8
*.keystore
*.mobileprovision

# Nhật ký hệ thống / Logs
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Các thiết lập IDE / Editor cá nhân
.vscode/
**/.vscode/
.idea/
**/.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# OS Caches / File hệ thống
.DS_Store
Thumbs.db
