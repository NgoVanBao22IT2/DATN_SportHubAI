# Cấu hình máy chủ HTTP
PORT=5000
NODE_ENV=development

# Cấu hình Cơ sở dữ liệu MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=123456789
DB_NAME=sporthubai

# Cấu hình JWT
JWT_ACCESS_SECRET=your_jwt_access_secret_key_should_be_very_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_should_be_even_longer
JWT_REFRESH_EXPIRES_IN=7d

# Tích hợp MoMo Sandbox
MOMO_PARTNER_CODE=your_partner_code
MOMO_ACCESS_KEY=your_access_key
MOMO_SECRET_KEY=your_secret_key
MOMO_API_URL=https://test-payment.momo.vn/v2/gateway/api
MOMO_REDIRECT_URL=https://sporthubai.local/payment-result
MOMO_IPN_URL=https://api.sporthubai.local/api/v1/payments/momo-webhook

# Lưu trữ Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Gửi Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
FROM_EMAIL=no-reply@sporthubai.com
